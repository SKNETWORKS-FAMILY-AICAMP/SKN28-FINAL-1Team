# 기존 .gitignore 내용 + 임시 부산물 차단

# 임시 작업 파일 (언더스코어 prefix)
_*.py
_*.txt
_*.json
_*.md

# golden-set은 2026-08-06부터 저장소 루트가 정식 위치다 (구: docs/golden-set).
# 예전 규칙 `/golden-set/`은 루트의 image_synthesize 임시 폴더를 막으려던 것인데,
# 폴더를 루트로 옮긴 뒤로는 정식 자산을 통째로 무시해 버려서 제거했다.
# 생성 요청 임시 JSON만 골라서 제외한다 (스크립트로 재생성 가능).
golden-set/**/_batches/
golden-set/**/_grid_batches/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# 환경 변수 / 시크릿
.env
.env.local
.env.*.local
*.pem
*.key

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
.DS_Store
desktop.ini

# Jupyter
.ipynb_checkpoints/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/

# 모델 가중치 (대용량)
*.pt
*.pth
*.pkl
*.joblib
*.h5
*.onnx

# 대용량 데이터
*.csv.gz
*.parquet
data/raw/
data/processed/

# 임시 / 캐시
tmp/
temp/
.cache/
*.tmp

# 로그
logs/
*.log
