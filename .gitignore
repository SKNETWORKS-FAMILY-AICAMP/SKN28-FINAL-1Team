# 기존 .gitignore 내용 + 임시 부산물 차단

# 임시 작업 파일 (언더스코어 prefix)
_*.py
_*.txt
_*.json
_*.md

# image_synthesize 임시 폴더 (루트만, docs/golden-set은 정식 위치)
/golden-set/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# 환경 변수 / 시크릿
.env
.env.local
.env.*.local
*.pem
*.key

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
.DS_Store
desktop.ini

# Jupyter
.ipynb_checkpoints/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# mypy
.mypy_cache/

# 모델 가중치 (대용량)
*.pt
*.pth
*.pkl
*.joblib
*.h5
*.onnx

# 대용량 데이터
*.csv.gz
*.parquet
data/raw/
data/processed/

# 임시 / 캐시
tmp/
temp/
.cache/
*.tmp

# 로그
logs/
*.log
